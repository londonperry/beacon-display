# BEACON Token Service - Cloud Version (Production)
# For production, use Azure Key Vault or AWS Secrets Manager
# NEVER commit actual .env files to git!

# ============================================
# AZURE AD CONFIGURATION
# ============================================
TENANT_ID=your-azure-tenant-id-here
CLIENT_ID=your-app-client-id-here
CLIENT_SECRET=your-client-secret-here

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=production

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins (REQUIRED for production)
# Example: ALLOWED_ORIGINS=https://192.168.1.10,https://192.168.1.11
# Or use domain names: ALLOWED_ORIGINS=https://display1.company.com,https://display2.company.com
# WARNING: Do NOT use * in production! This allows any website to call your API.
ALLOWED_ORIGINS=*

# ============================================
# PRODUCTION DEPLOYMENT - AZURE APP SERVICE
# ============================================
# Recommended deployment method for Azure-centric organizations
#
# 1. Create Azure App Service:
#    az webapp create \
#      --resource-group beacon-rg \
#      --plan beacon-plan \
#      --name beacon-token-service \
#      --runtime "NODE:18-lts"
#
# 2. Enable managed identity:
#    az webapp identity assign \
#      --resource-group beacon-rg \
#      --name beacon-token-service
#
# 3. Create Azure Key Vault:
#    az keyvault create \
#      --resource-group beacon-rg \
#      --name beacon-keyvault \
#      --enable-rbac-authorization
#
# 4. Store secrets in Key Vault:
#    az keyvault secret set \
#      --vault-name beacon-keyvault \
#      --name TENANT-ID \
#      --value "your-tenant-id"
#
# 5. Grant App Service access to Key Vault:
#    az role assignment create \
#      --role "Key Vault Secrets User" \
#      --assignee <managed-identity-id> \
#      --scope /subscriptions/<sub-id>/resourceGroups/beacon-rg/providers/Microsoft.KeyVault/vaults/beacon-keyvault
#
# 6. Configure App Service settings (reference Key Vault):
#    az webapp config appsettings set \
#      --resource-group beacon-rg \
#      --name beacon-token-service \
#      --settings \
#        TENANT_ID="@Microsoft.KeyVault(SecretUri=https://beacon-keyvault.vault.azure.net/secrets/TENANT-ID/)" \
#        CLIENT_ID="@Microsoft.KeyVault(SecretUri=https://beacon-keyvault.vault.azure.net/secrets/CLIENT-ID/)" \
#        CLIENT_SECRET="@Microsoft.KeyVault(SecretUri=https://beacon-keyvault.vault.azure.net/secrets/CLIENT-SECRET/)" \
#        NODE_ENV="production" \
#        ALLOWED_ORIGINS="https://your-display-ips-or-domains"
#
# 7. Enable continuous deployment:
#    - Connect to GitHub repo
#    - Or use: az webapp deployment source config
#
# 8. Configure custom domain and SSL (optional):
#    az webapp config hostname add \
#      --webapp-name beacon-token-service \
#      --resource-group beacon-rg \
#      --hostname beacon.company.com
#
# ============================================
# PRODUCTION DEPLOYMENT - AWS
# ============================================
# Alternative deployment for AWS-centric organizations
#
# Option A: Elastic Beanstalk
# 1. Install EB CLI: pip install awsebcli
# 2. Initialize: eb init -p node.js beacon-token-service
# 3. Create environment: eb create beacon-prod
# 4. Set environment variables:
#    eb setenv TENANT_ID=xxx CLIENT_ID=xxx CLIENT_SECRET=xxx
# 5. Deploy: eb deploy
#
# Option B: ECS Fargate (containerized)
# 1. Build Docker image: docker build -t beacon-token .
# 2. Push to ECR
# 3. Create ECS cluster, task definition, service
# 4. Use AWS Secrets Manager for secrets
# 5. Configure ALB with SSL certificate
#
# ============================================
# PRODUCTION DEPLOYMENT - DOCKER
# ============================================
# For self-hosted or on-premise deployments
#
# 1. Build image:
#    docker build -t beacon-token-service .
#
# 2. Run with environment variables:
#    docker run -d \
#      --name beacon-token \
#      -p 3000:3000 \
#      -e TENANT_ID="xxx" \
#      -e CLIENT_ID="xxx" \
#      -e CLIENT_SECRET="xxx" \
#      -e NODE_ENV="production" \
#      -e ALLOWED_ORIGINS="https://your-displays" \
#      beacon-token-service
#
# 3. Use Docker secrets (recommended):
#    echo "your-secret" | docker secret create client_secret -
#    docker service create \
#      --secret client_secret \
#      beacon-token-service
#
# 4. For production, use:
#    - Reverse proxy (nginx, Traefik) for HTTPS
#    - Docker Compose or Kubernetes for orchestration
#    - Health check monitoring
#
# ============================================
# SECURITY REQUIREMENTS (PRODUCTION)
# ============================================
# ❌ Do NOT use HTTP - HTTPS required
# ❌ Do NOT use ALLOWED_ORIGINS=* - Specify exact origins
# ❌ Do NOT store secrets in .env - Use Key Vault/Secrets Manager
# ❌ Do NOT use password SSH - Key-based authentication only
# ❌ Do NOT skip certificate validation
#
# ✅ DO use HTTPS with valid certificates
# ✅ DO restrict CORS to specific IPs/domains
# ✅ DO use managed secrets (Key Vault, Secrets Manager)
# ✅ DO rotate secrets every 3-6 months
# ✅ DO enable request logging and audit trails
# ✅ DO use network segmentation (IoT VLAN for displays)
# ✅ DO implement rate limiting
# ✅ DO monitor /health and /ready endpoints
#
# ============================================
# NETWORK SECURITY
# ============================================
# Firewall rules (corporate network):
# - Allow HTTPS (443) from display devices to token service
# - Allow HTTPS (443) from token service to:
#   - login.microsoftonline.com (Azure AD)
#   - api.powerbi.com (Power BI API)
#
# Recommended setup:
# - Token service in private subnet
# - Displays in IoT VLAN (isolated from corporate network)
# - NAT Gateway for outbound internet access
# - Network security groups (NSGs) or security groups
#
# ============================================
# MONITORING & ALERTING
# ============================================
# Health endpoints:
# - GET /health - Basic health check
# - GET /ready - Validates Azure AD connectivity
# - GET /metrics - Memory and uptime stats
#
# Recommended monitoring:
# - Application Insights (Azure) or CloudWatch (AWS)
# - Alert on /ready endpoint failures (indicates auth issues)
# - Alert on high memory usage (>80%)
# - Alert on error rate >5% over 5 minutes
# - Monitor token generation latency
#
# ============================================
# SCALABILITY
# ============================================
# For 100+ displays:
# - Use load balancer (Azure Load Balancer, AWS ALB)
# - Auto-scale based on CPU (target 70%)
# - Consider Redis caching for access tokens
# - Implement request queuing if needed
#
# For 500+ displays:
# - Dedicated App Service Plan or ECS cluster
# - Multiple instances (at least 3 for HA)
# - CDN for static assets (if any)
# - Database for audit logging
#
# ============================================
# TROUBLESHOOTING
# ============================================
# Common issues:
#
# 1. "Cannot acquire Azure AD token"
#    - Verify TENANT_ID, CLIENT_ID, CLIENT_SECRET
#    - Check client secret expiration
#    - Verify network access to login.microsoftonline.com
#
# 2. "Power BI API error: 403"
#    - Service principal not added to workspace
#    - Service principal APIs not enabled in tenant settings
#    - Workspace is "My Workspace" (not supported)
#
# 3. CORS errors from displays
#    - Add display IPs/domains to ALLOWED_ORIGINS
#    - Check HTTPS vs HTTP mismatch
#
# 4. High latency
#    - Check network connectivity
#    - Monitor Azure AD token cache
#    - Consider adding Redis for caching
#
# ============================================
# COST OPTIMIZATION
# ============================================
# Azure App Service:
# - Basic B1: ~$13/month (development)
# - Standard S1: ~$70/month (production, 100 displays)
# - Premium P1v2: ~$146/month (500+ displays, auto-scale)
#
# AWS Elastic Beanstalk:
# - t3.small: ~$15/month (development)
# - t3.medium: ~$30/month (production, 100 displays)
# - m5.large: ~$70/month (500+ displays)
#
# Self-hosted (on-premise):
# - VM costs vary by provider
# - Add SSL certificate cost (~$0-100/year)
# - Add monitoring/logging tools
