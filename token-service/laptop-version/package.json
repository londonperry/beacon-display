{
  "name": "beacon-token-service-laptop",
  "version": "1.0.0",
  "description": "BEACON Power BI embed token generation service for POC/development - runs on local machine",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "health-check": "curl -f http://localhost:3000/health || exit 1",
    "test": "node server.js & sleep 3 && npm run health-check && kill %1"
  },
  "keywords": [
    "powerbi",
    "authentication",
    "beacon",
    "raspberry-pi",
    "embed-token",
    "azure-ad",
    "msal",
    "dashboard",
    "analytics",
    "iot"
  ],
  "author": "BEACON Project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/beacon-display.git",
    "directory": "token-service/laptop-version"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "@azure/msal-node": "^2.6.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
